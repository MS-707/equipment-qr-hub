  "completedLenses": [
    {
      "lens": "Glossary compliance + consistency with shipped es.json shared vocabulary; no forbidden variants",
      "failures": [
        {
          "key": "syncFailedBadge",
          "reason": "\"Falló la sincronización\" does not match the shipped sync vocabulary: es.json already renders en \"Sync failed — will retry\" (sync.syncFailed) as \"No se pudo sincronizar — se reintentará\", and all shipped sync strings use verb forms of \"sincronizar\" (\"pendiente de sincronizar\", \"se sincronizará\", \"sincronizado\"). This badge and the sync.* strings can appear in the same UI, so the same failure state would show two different terms, violating the match-sync-terms-exactly requirement and the one-term-per-concept register rule.",
          "suggestion": "No se pudo sincronizar"
        },
