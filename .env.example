# ── Auth (Safety Hub) ────────────────────────────────────────
# Google OAuth. When unset, a dev/demo email sign-in is enabled automatically so
# the Safety Hub is usable out of the box. In production, set these AND ALLOW_DEV_LOGIN=0.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=              # e.g. https://equipment-qr-hub.vercel.app  (http://localhost:3000 in dev)
ALLOWED_EMAIL_DOMAINS=mytra.ai   # comma-separated; enforced server-side
ALLOW_DEV_LOGIN=           # 1 to force dev login on; 0 to force off; unset = on only when Google not configured

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS=              # comma-separated admin emails (server-only, never shipped to client)

# ── Notion sync (optional) ───────────────────────────────────
# Sync is a graceful no-op (503) until configured. Records stay 'pending' and retry.
NOTION_API_KEY=
NOTION_PTP_DB_ID=
NOTION_JHA_DB_ID=          # optional; falls back to NOTION_PTP_DB_ID
NOTION_PERMITS_DB_ID=
NOTION_INCIDENTS_DB_ID=
NOTION_INSPECTIONS_DB_ID=  # (existing) pre-trip inspections

# ── Email & Slack notifications (optional) ───────────────────
RESEND_API_KEY=            # Resend email API key
EHS_NOTIFY_EMAIL=          # recipient for EHS notifications (default: admin)
EHS_NOTIFY_FROM=           # sender address (default: Sage EHS <onboarding@resend.dev>)
SLACK_WEBHOOK_URL=         # general Slack webhook (first-login, beta signups)

# ── EHS Review workflow (optional; dormant by default) ───────
# Review UI is absent unless NEXT_PUBLIC_EHS_REVIEW=1. Polls Notion for status.
# Slack webhook is best-effort — no error if unset.
NEXT_PUBLIC_EHS_REVIEW=    # set to 1 to enable "Submit for EHS Review" workflow
SLACK_EHS_WEBHOOK_URL=     # optional Slack incoming webhook for review notifications
REVIEW_TOKEN_SECRET=       # HMAC secret for review tokens (falls back to NEXTAUTH_SECRET)

# ── Sage — AI safety assistant (optional; dormant by default) ─
# Sage UI is absent unless BOTH are set. Server route fails closed without the key.
ANTHROPIC_API_KEY=         # server-only
NEXT_PUBLIC_AI_ASSIST=     # set to 1 to reveal the "Ask Sage to suggest hazards" UI

# ── Vercel KV (optional — beta, rate limiting, user tracking) ─
KV_REST_API_URL=           # Vercel KV REST URL
KV_REST_API_TOKEN=         # Vercel KV REST token
